{% doc %}
  @prompt
    Create a continuous rolling text marquee section that scrolls from right to left infinitely. Allow multiple customizable text entries that display in a seamless loop. Include settings to add/remove text items, adjust scroll speed, text size, colors, and spacing. The animation should be smooth CSS-based with no gaps between loops. Make it responsive and include options for background colors and text styling.

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-marquee-container-{{ ai_gen_id }} {
    width: 100%;
    overflow: hidden;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.vertical_padding }}px 0;
    position: relative;
  }

  .ai-marquee-track-{{ ai_gen_id }} {
    display: flex;
    width: max-content;
    animation: ai-marquee-scroll-{{ ai_gen_id }} {{ block.settings.scroll_speed }}s linear infinite;
    gap: {{ block.settings.text_spacing }}px;
  }

  .ai-marquee-item-{{ ai_gen_id }} {
    white-space: nowrap;
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    font-weight: {{ block.settings.text_weight }};
    text-transform: {{ block.settings.text_transform }};
    letter-spacing: {{ block.settings.letter_spacing }}px;
    flex-shrink: 0;
  }

  .ai-marquee-separator-{{ ai_gen_id }} {
    color: {{ block.settings.separator_color }};
    font-size: {{ block.settings.text_size }}px;
    flex-shrink: 0;
  }

  @keyframes ai-marquee-scroll-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .ai-marquee-track-{{ ai_gen_id }}:hover {
    animation-play-state: {{ block.settings.pause_on_hover | default: false | ternary: 'paused', 'running' }};
  }

  @media screen and (max-width: 749px) {
    .ai-marquee-item-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.8 }}px;
    }
    
    .ai-marquee-separator-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.8 }}px;
    }
    
    .ai-marquee-container-{{ ai_gen_id }} {
      padding: {{ block.settings.vertical_padding | times: 0.7 }}px 0;
    }
  }
{% endstyle %}

<div class="ai-marquee-container-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-marquee-track-{{ ai_gen_id }}">
    {% liquid
      assign text_items = ''
      assign separator = block.settings.separator | default: '•'
      
      for i in (1..10)
        assign text_key = 'text_' | append: i
        assign text_value = block.settings[text_key]
        if text_value != blank
          if text_items != blank
            assign text_items = text_items | append: '|' | append: text_value
          else
            assign text_items = text_value
          endif
        endif
      endfor
      
      assign text_array = text_items | split: '|'
    %}
    
    {% if text_array.size > 0 %}
      {% for i in (1..2) %}
        {% for text in text_array %}
          <span class="ai-marquee-item-{{ ai_gen_id }}">{{ text }}</span>
          {% unless forloop.last and forloop.parentloop.last %}
            <span class="ai-marquee-separator-{{ ai_gen_id }}">{{ separator }}</span>
          {% endunless %}
        {% endfor %}
      {% endfor %}
    {% else %}
      {% for i in (1..2) %}
        <span class="ai-marquee-item-{{ ai_gen_id }}">Add your text content in the block settings</span>
        <span class="ai-marquee-separator-{{ ai_gen_id }}">{{ separator }}</span>
        <span class="ai-marquee-item-{{ ai_gen_id }}">Customize colors, speed, and styling</span>
        <span class="ai-marquee-separator-{{ ai_gen_id }}">{{ separator }}</span>
        <span class="ai-marquee-item-{{ ai_gen_id }}">Perfect for announcements and promotions</span>
        {% unless forloop.last %}
          <span class="ai-marquee-separator-{{ ai_gen_id }}">{{ separator }}</span>
        {% endunless %}
      {% endfor %}
    {% endif %}
  </div>
</div>

